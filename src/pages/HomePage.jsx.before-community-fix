          <div className="home-sidebar-card">
            <nav className="sidebar-nav">
              <a href="#inicio">🏠 Início</a>

              <a href="#eventos">
                📅 Encontros
              </a>

              {isTeamView && (
                <>
                  <a href="#combinados">
                    🤝 Combinados
                  </a>

                  <a href="#minhas-missoes">
                    🚀 Minhas missões
                  </a>
                </>
              )}

              <a href="#missoes">
                💡 Missões
              </a>

              <a href="#mural">
                📢 Mural
              </a>

              {isGeneralView && (
                <a href="#memorias">
                  📸 Memórias
                </a>
              )}
            </nav>
          </div>
        </aside>

        <main
          className={`app-shell home-main project-theme-${String(
