# =========================================================
# LOCAL DEVELOPMENT ONLY
# Copy this file to .env and fill in the values.
# NEVER commit .env to GitHub.
# =========================================================

SECRET_KEY=change-me-locally

# Neon -> Connection Details -> pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Initial admin password used only when the seed admin is created.
SEED_ADMIN_PASSWORD=change-this

# Supabase -> Project Settings / API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# SERVER SECRET. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Create this as a PUBLIC Storage bucket in Supabase.
SUPABASE_BUCKET=central-media
